<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Evento que se activa cuando se selecciona una carrera
    document.getElementById('carrerasrch').addEventListener('change', function() {
      const carreraId = this.value;
      const materiaSelect = document.getElementById('xmateria');

      // Limpiar el select de materias
      materiaSelect.innerHTML = '<option selected value="nones">Elegir Materia</option>';
      console.log("Datos a enviar:", {
        id_carrera: carreraId
      });

      // Hacer la solicitud AJAX para obtener las materias de la carrera seleccionada
      fetch('student/handleSubjectFilter', {
          method: 'POST',
          body: JSON.stringify({
            id_carrera: carreraId
          }),
          headers: {
            'Content-Type': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          // Llenar el select de materias con los datos obtenidos
          console.log("Respuesta de PHP cambio carrera:", data);

          data.forEach(materia => {
            const option = document.createElement('option');
            option.value = materia.idmateria;
            if (materia.id_materia == 0) {
              option.textContent = materia.materia_des + ' (No disponible)';
            } else {
              option.textContent = materia.materia_des;
            }
            if (materia.id_materia == 0) {
              option.disabled = true;
            }
            materiaSelect.appendChild(option);
          });
        })
        .catch(error => {
          console.error('Error al obtener materias:', error);
        });

    });
    document.getElementById('xmateria').addEventListener('change', function() {
      const materiaId = this.value;
      const tutorSelect = document.getElementById('xtutor');
      tutorSelect.style.display = 'block';
      const openModalButton = document.getElementById('tutorbtn');
      openModalButton.style.display = 'none';

      // Limpiar el select de materias
      tutorSelect.innerHTML = '<option selected value="nones">Elegir Tutor</option>';
      console.log("Datos a enviar:", {
        id_materia: materiaId
      });

      // Hacer la solicitud AJAX para obtener las materias de la carrera seleccionada
      fetch('student/handleTutorFilter', {
          method: 'POST',
          body: JSON.stringify({
            id_materia: materiaId
          }),
          headers: {
            'Content-Type': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          // Llenar el select de materias con los datos obtenidos
          console.log("Respuesta de PHP tutores:", data);

          data.forEach(tutor => {
            const option = document.createElement('option');
            option.value = tutor.id;
            option.textContent = tutor.tutor;
            tutorSelect.appendChild(option);
          });
        })
        .catch(error => {
          console.error('Error al obtener tutores:', error);
        });

    });
    
    let selectedValue = ''; // Declare selectedValue globally
let selectedMateria = ''; // Declare selectedMateria globally
let isSeeHoraListenerAdded = false; // Flag to track if the event listener is added

document.getElementById('xtutor').addEventListener('change', function () {
  selectedValue = this.value; // Update the globally declared variable

  const openModalButton = document.getElementById('tutorbtn');
  openModalButton.style.display = 'inline-block';

  const openModalHandler = function () {
    console.log("Datos a enviar del tutor seleccionado:", { id_tutor: selectedValue });
    fetch('student/handleTutorProfile', {
        method: 'POST',
        body: JSON.stringify({ id_tutor: selectedValue }),
        headers: { 'Content-Type': 'application/json' }
      })
      .then(response => response.json())
      .then(data => {
        console.log("Respuesta de PHP el profile:", data);
        const tutor = data;
        const tutorProfile = document.getElementById('tutorProfile');
        tutorProfile.innerHTML = '';
        document.getElementById('aboutme').textContent = '';

        const imgElement = document.createElement('img');
        imgElement.src = tutor.foto ? `http://localhost/tutor_link/public/img/profiles/${tutor.foto}.jpg` : 'http://localhost/tutor_link/public/img/profiles/profile.JFIF';
        imgElement.className = 'img-thumbnail ml-2';
        imgElement.alt = 'Perfil del Tutor';
        tutorProfile.appendChild(imgElement);

        document.getElementById('nameprofile').textContent = tutor.name;
        document.getElementById('dateprofile').textContent = tutor.date;
        if (tutor.about) {
          document.getElementById('aboutme').innerHTML =
            '<H5>Mi Experiencia</H5>' + '<p class = "text-left">' + tutor.about + '</p>';
        }
      })
      .catch(error => {
        console.error('Error al obtener el perfil del tutor:', error);
      });
  };

  openModalButton.replaceWith(openModalButton.cloneNode(true));
  const newOpenModalButton = document.getElementById('tutorbtn');
  newOpenModalButton.addEventListener('click', openModalHandler);

  if (!isSeeHoraListenerAdded) {
    const seehoraButton = document.getElementById('seehora');
    const seehoraHandler = function () {
      $('#exampleModal4').modal('hide').on('hidden.bs.modal', function () {
        $('.modal-backdrop').remove();
        $('#exampleModal4').off('hidden.bs.modal'); // Remove the handler after it is used

        console.log("Respuesta de antesPHP:", selectedValue);
        fetch('student/getsessionsEst', {
            method: 'POST',
            body: JSON.stringify({ id_tutor: selectedValue }),
            headers: { 'Content-Type': 'application/json' }
          })
          .then(response => response.json())
          .then(data => {
            console.log("Respuesta de PHP:", data);
            const horariosTableBody = document.getElementById('horariosTableBody');
            horariosTableBody.innerHTML = '';
            data.forEach(item => {
              const row = document.createElement('tr');
              let button;
              if (item.cupo <= 0) {
                button = `<button class='btn btn-primary small-button' disabled>Sin cupo</button>`;
              } else if (item.estado_inscripcion === 'Inscrito') {
                button = `<button class='btn btn-primary small-button' disabled>Inscrito</button>`;
              } else {
                button = `<button class='btn btn-primary small-button' data-dismiss="modal" onclick='registrar(${item.id_horario})'>Registrar</button>`;
              }
              row.innerHTML = `<td>${item.materia_des}</td>
                                   <td>${item.dia}</td>
                                   <td>${item.h_inicio}</td>
                                   <td>${item.h_final}</td>
                                   <td>${item.cupo || 0}</td>
                                   <td>${button}</td>`;
              horariosTableBody.appendChild(row);
            });
            $('#exampleModal3').modal('show');
          })
          .catch(error => {
            console.error('Error al obtener los horarios:', error);
          });
      });
    };

    seehoraButton.addEventListener('click', seehoraHandler);
    isSeeHoraListenerAdded = true; // Mark the event listener as added
  }
});

// Event listener for 'Solicitar Clase Particular'
document.getElementById('clasespart').addEventListener('click', function () {
  selectedMateria = document.getElementById('xmateria').value;

  console.log("Datos a enviar para solicitar clase particular:", {
    id_tutor: selectedValue,
    id_materia: selectedMateria
  });

  fetch('student/requestPrivateClass', {
    method: 'POST',
    body: JSON.stringify({
      id_tutor: selectedValue,
      id_materia: selectedMateria
    }),
    headers: {
      'Content-Type': 'application/json'
    }
  })
  .then(response => {
    if (!response.ok) {
      throw new Error('Network response was not ok');
    }
    return response.json();
  })
  .then(data => {
    console.log("Respuesta de PHP para solicitar clase particular:", data);
    alert("Solicitud de Clase particular agregada correctamente.");
    window.location.reload();
  })
  .catch(error => {
    console.error('Error al solicitar clase particular:', error);
  });
});



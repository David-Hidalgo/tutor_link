  function actualizarTabla(data) {
    const tableBody = document.getElementById('productTableBodyE');
    tableBody.innerHTML = '';
    // Limpiar contenido previo
    data.forEach(item => {
      const row = document.createElement('tr');
      const button = ` <button class="btn btn-outline-secondary small-button" data-toggle="popover" data-trigger="focus" data-html="true" title="Tutor: ${item.tutor}" data-content="Teléfono: ${item.telefono}<br>Email: ${item.email}"> Ver </button>`;
      const button2 = ` <button class="btn btn-outline-secondary small-button" data-toggle="modal" data-target="#exampleModal5${item.id}"> Eliminar </button>`;
      row.innerHTML = ` <td>${item.dia}</td>
                         <td>${item.materia_des}</td>
                          <td>${item.h_inicio}</td>
                           <td>${item.h_final}</td>
                            <td>${button}</td> 
                             <td>${button2}</td> `;
      tableBody.appendChild(row);
    });
    $(document).ready(function() {
      $('[data-toggle="popover"]').popover();
    });
    $('.popover-dismiss').popover({
      trigger: 'focus'
    })
  }
